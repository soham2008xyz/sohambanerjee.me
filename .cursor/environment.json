{
  "name": "The Nonconformist (Jekyll)",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "install": "bash .cursor/install.sh",
  "ports": [
    {
      "name": "jekyll",
      "port": 4000
    }
  ],
  "terminals": [
    {
      "name": "jekyll",
      "command": "bundle exec jekyll serve --host 0.0.0.0 --port 4000 --livereload",
      "description": "Jekyll development server at http://localhost:4000"
    }
  ]
}
